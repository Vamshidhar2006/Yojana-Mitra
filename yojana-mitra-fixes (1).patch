+"""Regression tests for the retrieval / rule-engine fixes.
+
+Run from the repo root:
+
+    python -m pytest tests/test_retrieval_fixes.py -q
+    # or, without pytest:
+    python tests/test_retrieval_fixes.py
+
+No ChromaDB, torch or network access is needed: the Chroma collection is
+replaced by a small fake so the filtering logic can be tested on its own.
+"""
+
+import sys
+import types
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+if str(ROOT) not in sys.path:
+    sys.path.insert(0, str(ROOT))
+
+
+BASE_PROFILE = {
+    "age": 21,
+    "state": "Telangana",
+    "income": 300000,
+    "gender": "Male",
+    "social_category": "General",
+}
+
+FRONTEND_OCCUPATIONS = [
+    "Student", "Farmer", "Self Employed", "Government Employee",
+    "Private Employee", "Business", "Unemployed", "Homemaker",
+    "Retired", "Other",
+]
+
+
+# ----------------------------------------------------------------------
+# vocabulary
+# ----------------------------------------------------------------------
+
+def test_frontend_occupations_map_to_csv_vocabulary():
+    from backend.rag.vocab import canonical_user_occupation as c
+
+    assert c("Student") == "student"
+    assert c("Farmer") == "farmer"
+    assert c("Self Employed") == "self_employed"
+    assert c("Government Employee") == "salaried"
+    assert c("Private Employee") == "salaried"
+    assert c("Business") == "self_employed"
+    assert c("Unemployed") == "unemployed"
+
+    # no equivalent in the CSV -> must never exclude anything
+    for label in ("Homemaker", "Retired", "Other", "", None):
+        assert c(label) is None
+
+
+def test_beneficiary_types_are_not_occupations():
+    from backend.rag.vocab import occupation_status as status
+
+    for cell in ("Individual", "Family", "Business Entity", "NGO",
+                 "Individual, Family", "Registered Societies", None):
+        assert status("Student", cell) == "unknown", cell
+
+    assert status("Student", "student;daily_wage") == "eligible"
+    assert status("Self Employed", "self_employed") == "eligible"
+    assert status("Farmer", "student") == "not_eligible"
+
+
+# ----------------------------------------------------------------------
+# eligibility filter (the step in front of Chroma)
+# ----------------------------------------------------------------------
+
+def test_every_frontend_occupation_keeps_a_reasonable_candidate_pool():
+    from backend.rag import eligibility
+
+    # Before the fix 6 of these 10 occupations left only 11 of 4,705
+    # schemes, because almost every row was judged "not eligible".
+    for occupation in FRONTEND_OCCUPATIONS:
+
+        candidates = eligibility.get_candidate_schemes(
+            dict(BASE_PROFILE, occupation=occupation)
+        )
+
+        assert len(candidates) > 200, (occupation, len(candidates))
+
+
+def test_individual_schemes_survive_for_students():
+    from backend.rag import eligibility
+
+    ids = {
+        c["scheme_name"]
+        for c in eligibility.get_candidate_schemes(
+            dict(BASE_PROFILE, occupation="Student")
+        )
+    }
+
+    # occupation column says "Individual" for this scheme
+    assert "Aam Aadmi Bima Yojana" in ids
+
+
+def test_real_mismatches_are_still_excluded():
+    from backend.rag import eligibility
+
+    # a female-only scheme must not reach a male user
+    result = eligibility.check_scheme(
+        dict(BASE_PROFILE, occupation="Student"),
+        {"gender": "female", "state": "All India"}
+    )
+    assert result["checks"]["gender"] == "not_eligible"
+
+    # a state-specific scheme must not reach another state
+    result = eligibility.check_scheme(
+        dict(BASE_PROFILE, occupation="Student"),
+        {"state": "Kerala"}
+    )
+    assert result["status"] == "not_eligible"
+
+    # "Other" gender cannot be confirmed, but is not ruled out
+    result = eligibility.check_scheme(
+        dict(BASE_PROFILE, gender="Other"),
+        {"gender": "female"}
+    )
+    assert result["checks"]["gender"] == "unknown"
+
+
+# ----------------------------------------------------------------------
+# scheme-name matching
+# ----------------------------------------------------------------------
+
+def test_named_scheme_matching():
+    from backend.rag.name_match import find_scheme_matches
+
+    def best(text):
+        matches = find_scheme_matches(text)
+        return matches[0]["scheme_name"] if matches else None
+
+    assert best("Tell me about PM-KISAN") == "PM-KISAN Samman Nidhi"
+    assert best("Tell me about PMAY-G") == "Pradhan Mantri Awas Yojana - Gramin"
+
+    # used to return PM-KISAN Samman Nidhi (alias was a substring check)
+    assert best("Tell me about PM Kisan Maandhan") == \
+        "Pradhan Mantri Kisan Maandhan Yojana"
+    assert best("benefits of PM Kisan Maan-Dhan Yojana") == \
+        "Pradhan Mantri Kisan Maandhan Yojana"
+
+    # longest name wins
+    assert best("documents for Kisan Credit Card (Pashupalan)") == \
+        "Kisan Credit Card (Pashupalan)"
+    assert best("documents for Kisan Credit Card") == "Kisan Credit Card"
+
+    # general questions must not match a scheme
+    for text in ("What is the best scheme for farmers?",
+                 "schemes for women in Karnataka",
+                 "scholarships for students"):
+        assert best(text) is None, text
+
+
+def test_did_you_mean_suggestions():
+    from backend.rag.name_match import suggest_similar
+
+    assert "Rythu Bima Scheme" in suggest_similar("Rythu Bandhu")
+
