@@ -0,0 +1,246 @@
+"""Vocabulary helpers shared by both chatbots.
+
+Why this file exists
+--------------------
+The profile form (frontend) and the scheme CSV use different words for
+the same things:
+
+    frontend occupation     CSV occupation column
+    --------------------    -----------------------------------------
+    "Self Employed"         "self_employed"            (underscore)
+    "Government Employee"   "salaried"
+    "Private Employee"      "salaried"
+    "Business"              "self_employed" / "Business Entity"
+    "Homemaker", "Other"    (no equivalent)
+
+On top of that, ~1,600 rows have a *beneficiary type* ("Individual",
+"Family", "Business Entity", "NGO", ...) stored in the occupation column.
+The old filter treated those as occupations, so a Student never matched
+any "Individual" scheme and most non-student profiles matched only ~11 of
+4,705 schemes.
+
+The rule used here: only the six real occupations below can EXCLUDE a
+scheme. Anything else in the CSV is ignored, and a user occupation we
+cannot map (Homemaker, Retired, Other) never excludes anything.
+"""
+
+import re
+
+
+# ---------------------------------------------------------------------
+# Text normalisation
+# ---------------------------------------------------------------------
+
+def norm(value):
+    """Lower-case, '&' -> 'and', everything else non-alphanumeric -> space."""
+
+    if value is None:
+        return ""
+
+    if isinstance(value, float) and value != value:  # NaN
