+# ----------------------------------------------------------------------
+# YojanaLM rule engine
+# ----------------------------------------------------------------------
+
+def test_profile_extraction_from_free_text():
+    from backend.yojanaLM.retrieval.engine import extract_user_profile_v31 as ex
+
+    # "years old" used to be missed ('year' + 's' broke the regex)
+    assert ex("I am 21 years old")["age"] == 21
+    assert ex("I am 21-year-old")["age"] == 21
+    assert ex("aged 45")["age"] == 45
+
+    # income formats
+    assert ex("my income is 3.5 lakh")["income"] == 350000
+    assert ex("annual income of 300000.0")["income"] == 300000
+    assert ex("income Rs 3,00,000")["income"] == 300000
+
+    # states the old hard-coded list did not know, and word boundaries
+    assert ex("I live in Puducherry")["state"] == "puducherry"
+    assert ex("schemes in Chandigarh")["state"] == "chandigarh"
+    assert ex("what is my goal")["state"] == ""          # 'goa' in 'goal'
+    assert ex("a farmer from Orissa")["state"] == "odisha"
+
+    # occupations are canonical CSV values
+    assert ex("I am a self-employed trader")["occupation"] == "self_employed"
+    assert ex("I work as a daily wage labourer")["occupation"] == "daily_wage"
+    assert ex("I am a student")["occupation"] == "student"
+
+
+def test_form_profile_is_used_directly():
+    from backend.yojanaLM.retrieval.engine import (
+        extract_user_profile_v31, merge_profiles, profile_from_form
+    )
+
+    form = {
+        "age": 21, "state": "Telangana", "occupation": "Government Employee",
+        "income": 300000.0, "gender": "Male", "social_category": "General",
+    }
+
+    profile = profile_from_form(form)
+
+    assert profile["age"] == 21
+    assert profile["income"] == 300000
+    assert profile["state"] == "telangana"
+    assert profile["occupation"] == "salaried"
+    assert profile["gender"] == "male"
+    assert profile["social_category"] == "general"
+
+    # something said in the question overrides the form
+    merged = merge_profiles(
+        profile,
+        extract_user_profile_v31("I am a farmer from Kerala")
+    )
+    assert merged["occupation"] == "farmer"
+    assert merged["state"] == "kerala"
+    assert merged["age"] == 21            # not mentioned -> kept from form
+
+
+def test_engine_answers_for_every_frontend_occupation():
+    from backend.yojanaLM.retrieval.engine import yojana_query_v32
+
+    for occupation in FRONTEND_OCCUPATIONS:
+
+        form = dict(BASE_PROFILE, occupation=occupation)
+
+        result = yojana_query_v32(
+            "What schemes can I apply for?",
+            top_k=5,
+            profile_override=form
+        )
+
+        assert result["retrieval_type"] == "attribute_filtered_search"
+        assert len(result["results"]) > 0, occupation
+
+
+def test_answers_for_named_and_generic_questions():
+    from backend.yojanaLM.retrieval.answer import yojana_answer
+
+    form = dict(BASE_PROFILE, occupation="Farmer")
+
+    answer = yojana_answer(
+        "Tell me about PM Kisan Maandhan",
+        profile=form
+    )["answer"]
+    assert "Maandhan" in answer.split("\n")[0]
+
+    # general question -> a search, not "I couldn't find an exact match"
+    answer = yojana_answer(
+        "What is the best scheme for farmers?",
+        profile=form
+    )["answer"]
+    assert "exact match" not in answer
+    assert answer.startswith("I found")
+
+    # unknown scheme name -> honest "not found" plus suggestions
+    answer = yojana_answer("Tell me about Rythu Bandhu", profile=form)["answer"]
+    assert "exact match" in answer
+    assert "Rythu Bima Scheme" in answer
+
+
+# ----------------------------------------------------------------------
+# Chroma retrieval logic (fake collection, no chromadb needed)
+# ----------------------------------------------------------------------
+
+class FakeCollection:
+    """Mimics the parts of a Chroma collection that we use."""
+
+    def __init__(self, n=1000):
+        self.ids = [f"id{i}" for i in range(n)]
+        self.query_sizes = []
+
+    def count(self):
+        return len(self.ids)
+
+    def query(self, query_embeddings, n_results, include=None, where=None):
+
+        assert where is None, "must not send a giant $in filter to Chroma"
+
+        self.query_sizes.append(n_results)
+
+        ids = self.ids[:n_results]          # id0 is the nearest neighbour
+
+        return {
+            "ids": [ids],
+            "documents": [[f"doc {i}" for i in ids]],
+            "metadatas": [[{"scheme_name": f"name {i}"} for i in ids]],
+            "distances": [[float(k) for k in range(len(ids))]],
+        }
+
+    def get(self, ids, include=None):
+        return {
+            "ids": list(ids),
+            "documents": [f"doc {i}" for i in ids],
+            "metadatas": [{"scheme_name": f"name {i}"} for i in ids],
+        }
+
+
+def _load_personalized_retrieval(fake, candidate_ids, named_ids):
+
+    chromadb = types.ModuleType("chromadb")
+    chromadb.PersistentClient = lambda path: types.SimpleNamespace(
+        get_collection=lambda name: fake
+    )
+
+    embeddings = types.ModuleType("backend.rag.embeddings")
+    embeddings.create_embeddings = lambda texts: [[0.0] * 4 for _ in texts]
+
+    sys.modules["chromadb"] = chromadb
+    sys.modules["backend.rag.embeddings"] = embeddings
+    sys.modules.pop("backend.rag.personalized_retrieval", None)
+
+    import importlib
+    module = importlib.import_module("backend.rag.personalized_retrieval")
+
+    module.get_candidate_schemes = lambda profile: [
+        {"scheme_id": i} for i in candidate_ids
+    ]
+    module.find_named_scheme_ids = lambda query, limit=2: list(named_ids)
+
+    return module
+
+
+def test_retrieval_filters_after_vector_search():
+
+    fake = FakeCollection(1000)
+
+    # only every 10th scheme is allowed for this profile
+    allowed = [f"id{i}" for i in range(0, 1000, 10)]
+
+    module = _load_personalized_retrieval(fake, allowed, [])
+
+    out = module.personalized_search({}, "any question", top_k=5)
+
+    assert out["ids"][0] == ["id0", "id10", "id20", "id30", "id40"]
+    assert len(out["documents"][0]) == 5
+    assert fake.query_sizes == [300]          # one pass was enough
+
+
+def test_retrieval_widens_when_profile_is_narrow():
+
+    fake = FakeCollection(1000)
+
+    # allowed ids all sit far from the query
+    allowed = [f"id{i}" for i in (800, 810, 820, 830, 840, 850)]
+
+    module = _load_personalized_retrieval(fake, allowed, [])
+
+    out = module.personalized_search({}, "any question", top_k=3)
+
+    assert out["ids"][0] == ["id800", "id810", "id820"]
+    assert fake.query_sizes == [300, 1000]    # widened to the full set
+
+
+def test_named_scheme_is_pinned_even_if_profile_excludes_it():
+
+    fake = FakeCollection(1000)
+
+    allowed = [f"id{i}" for i in range(0, 1000, 10)]
+
+    module = _load_personalized_retrieval(fake, allowed, ["id777"])
+
+    out = module.personalized_search({}, "tell me about X", top_k=3)
+
+    assert out["ids"][0][0] == "id777"
+    assert out["distances"][0][0] == 0.0
+    assert out["ids"][0][1:] == ["id0", "id10"]
+    assert len(out["ids"][0]) == 3
+
+
+def test_empty_candidates_returns_empty_structure():
+
+    fake = FakeCollection(10)
+
+    module = _load_personalized_retrieval(fake, [], [])
+
+    out = module.personalized_search({}, "q", top_k=3)
+
+    assert out["documents"] == [[]]
+    assert out["metadatas"] == [[]]
+
