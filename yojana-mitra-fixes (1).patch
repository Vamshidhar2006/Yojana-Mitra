index 0000000..9ba784c
--- /dev/null
+++ b/backend/rag/name_match.py
@@ -0,0 +1,267 @@
+"""Find the scheme a user is naming in a question.
+
+The previous exact-name logic only worked if the user typed the full
+official scheme name, and it used a substring alias check, so any
+question containing "PM Kisan" (including "PM Kisan Maandhan") returned
+PM-KISAN Samman Nidhi.
+
+Rules used here
+---------------
+* Names are compared after normalisation, with generic words
+  ("yojana", "scheme", "the", ...) removed and "Pradhan Mantri" / "Chief
+  Minister" shortened to "pm" / "cm", because users type the short form.
+* A scheme matches when its whole (compacted) name appears in the
+  question, so "PM Kisan Maan-dhan" matches "Pradhan Mantri Kisan
+  Maandhan Yojana".
+* Short abbreviations come from ALIASES (only for schemes that exist in
+  the CSV).
+* When several schemes match, the LONGEST match wins. That is what makes
+  "PM Kisan Maandhan" beat the "PM Kisan" alias.
+* Nothing fuzzy is ever returned as a match. Fuzzy matching is only used
+  to offer "did you mean ...?" suggestions.
+"""
+
+import difflib
+import re
+from functools import lru_cache
+
+from backend.rag.data import load_master
+from backend.rag.vocab import norm
+
+
+GENERIC = frozenset({
+    "yojana", "yojna", "scheme", "schemes", "programme", "program",
+    "mission", "abhiyan", "the", "of", "for", "and", "in", "to", "a",
+    "an", "under", "by", "with", "from", "on",
+})
+
+# alias (norm()-ed)  ->  official scheme name (as written in the CSV)
+ALIASES = {
+    "pm kisan": "PM-KISAN Samman Nidhi",
+    "pmkisan": "PM-KISAN Samman Nidhi",
+    "pm kisan nidhi": "PM-KISAN Samman Nidhi",
+    "kisan samman nidhi": "PM-KISAN Samman Nidhi",
+    "pmay g": "Pradhan Mantri Awas Yojana - Gramin",
+    "pmayg": "Pradhan Mantri Awas Yojana - Gramin",
+    "pm jay": "Ayushman Bharat PM-JAY",
+    "pmjay": "Ayushman Bharat PM-JAY",
+    "kcc": "Kisan Credit Card",
+}
+
+
+def _prep(text):
+    """norm() plus the short forms people actually type."""
+
+    text = norm(text)
+    text = re.sub(r"\bpradhan mantri\b", "pm", text)
+    text = re.sub(r"\b(chief minister|mukhya mantri|mukhyamantri)\b", "cm", text)
+
+    return text
+
+
+def _tokens(text):
+
+    return [t for t in _prep(text).split() if t not in GENERIC]
+
+
+@lru_cache(maxsize=1)
+def _index():
+
+    master = load_master()
+
+    entries = []
+
+    for scheme_id, name in zip(
+        master["scheme_id"].astype(str),
+        master["scheme_name"].fillna("").astype(str)
+    ):
+
+        tokens = tuple(_tokens(name))
+
+        if not tokens:
+            continue
+
+        entries.append({
+            "scheme_id": scheme_id,
+            "scheme_name": name,
+            "prep": _prep(name),
+            "tokens": tokens,
+            "key": "".join(tokens),
+        })
+
+    return entries
+
+
+def _contains_sequence(haystack, needle):
+
+    n = len(needle)
+
+    if n == 0:
+        return False
+
+    return any(
+        haystack[i:i + n] == needle
+        for i in range(len(haystack) - n + 1)
+    )
+
+
+def find_scheme_matches(query):
+    """All schemes named in `query`, best (longest) match first."""
+
+    query_tokens = [t for t in _prep(query).split()]
+    query_no_generic = [t for t in query_tokens if t not in GENERIC]
+    query_compact = "".join(query_no_generic)
+
+    hits = {}
+
+    # 1) full official name present in the question
+    for entry in _index():
+
+        key = entry["key"]
+
+        if len(key) >= 8:
+            matched = key in query_compact
+        else:
+            matched = _contains_sequence(
+                query_no_generic,
+                list(entry["tokens"])
+            )
+
+        if matched:
+            hits[entry["scheme_id"]] = (len(key), "name", entry)
+
+    # 2) known abbreviations
+    for alias, official in ALIASES.items():
+
+        alias_tokens = alias.split()
+
+        if not _contains_sequence(query_tokens, alias_tokens):
+            continue
+
+        official_prep = _prep(official)
+
+        for entry in _index():
+
+            if entry["prep"] != official_prep:
+                continue
+
+            length = len("".join(alias_tokens))
+            current = hits.get(entry["scheme_id"])
+
+            if current is None or length > current[0]:
+                hits[entry["scheme_id"]] = (length, "alias", entry)
+
+    ranked = sorted(
+        hits.values(),
+        key=lambda item: item[0],
+        reverse=True
+    )
+
+    return [
+        {
+            "scheme_id": entry["scheme_id"],
+            "scheme_name": entry["scheme_name"],
+            "match": kind,
+            "length": length,
+        }
+        for length, kind, entry in ranked
+    ]
+
+
+def find_best_scheme_row(query, master=None):
+    """The master-CSV row for the single best named scheme, or None."""
+
+    matches = find_scheme_matches(query)
+
+    if not matches:
+        return None
+
+    if master is None:
+        master = load_master()
+
+    scheme_id = matches[0]["scheme_id"]
+
+    rows = master[master["scheme_id"].astype(str) == scheme_id]
+
+    if rows.empty:
+        return None
+
+    return rows.iloc[0]
+
+
+def find_named_scheme_ids(query, limit=2):
+
+    return [
+        match["scheme_id"]
+        for match in find_scheme_matches(query)[:limit]
+    ]
+
+
+@lru_cache(maxsize=1)
+def _token_index():
+
+    inverted = {}
+
+    for position, entry in enumerate(_index()):
+
+        for token in set(entry["tokens"]):
+            inverted.setdefault(token, set()).add(position)
+
+    return inverted
+
+
+def suggest_similar(phrase, limit=3):
+    """'Did you mean' names for a phrase that matched nothing."""
+
+    phrase_tokens = _tokens(phrase)
+
+    if not phrase_tokens:
+        return []
+
+    inverted = _token_index()
+    vocabulary = list(inverted)
+
+    scores = {}
+
+    for token in set(phrase_tokens):
+
+        close = difflib.get_close_matches(
+            token,
+            vocabulary,
+            n=3,
+            cutoff=0.8
+        )
+
+        for similar in close:
+
+            positions = inverted[similar]
+
+            # rare words are stronger evidence than common ones
+            weight = 1.0 / len(positions)
+
+            for position in positions:
+                scores[position] = scores.get(position, 0.0) + weight
+
+    if not scores:
+        return []
+
+    entries = _index()
+
+    ranked = sorted(
+        scores.items(),
+        key=lambda item: (-item[1], len(entries[item[0]]["tokens"]))
+    )
+
+    names = []
+
+    for position, _ in ranked:
+
+        name = entries[position]["scheme_name"]
+
+        if name not in names:
+            names.append(name)
+
+        if len(names) == limit:
+            break
+
+    return names
